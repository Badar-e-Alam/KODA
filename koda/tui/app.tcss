/* KODA TUI stylesheet
 * Custom palette variables (overridden at runtime by KodaApp.apply_theme).
 * Defaults = Tokyo Night (koda theme).
 */
$background: #1a1b26;
$surface: #24283b;
$foreground: #c0caf5;
$primary: #7aa2f7;
$accent: #bb9af7;
$error: #f7768e;
$user: #9ece6a;
$tool: #e0af68;
$tool-ok: #73daca;
$tool-err: #f7768e;
$muted: #565f89;

Screen {
    background: $background;
    layers: base popup;
}

/* ── Layout ─────────────────────────────────────────────────── */

#app-root {
    layout: vertical;
    height: 100%;
    layer: base;
}

#main-row {
    height: 1fr;
    layout: horizontal;
}

#chat-area {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#messages {
    height: 1fr;
    background: $background;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#sidebar-host {
    width: auto;
    max-width: 40;
    display: none;
}

#sidebar-host.visible {
    display: block;
}

/* ── Banner ─────────────────────────────────────────────────── */

KodaBanner {
    height: auto;
    padding: 1 2;
    color: $primary;
}

/* ── Messages ───────────────────────────────────────────────── */

BaseMessage {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

UserMessage {
    color: $user;
    border-left: thick $user;
    padding-left: 1;
}

AssistantMessage {
    color: $foreground;
}

ToolCallMessage {
    color: $tool;
    padding: 0;
}

ToolCallMessage.-error {
    color: $tool-err;
}

AppMessage {
    color: $muted;
    text-style: italic;
}

ErrorMessage {
    color: $error;
    text-style: bold;
    border-left: thick $error;
    padding-left: 1;
}

ThinkingMessage {
    color: $muted;
    text-style: italic;
    height: 1;
    padding: 0 1;
}

/* ── Chat input ─────────────────────────────────────────────── */

ChatInput {
    height: 3;
    border: round $muted;
    padding: 0 1;
    background: $surface;
}

ChatInput:focus {
    border: round $primary;
}

ChatInput.-shell {
    border: round $tool;
}

ChatInput.-command {
    border: round $accent;
}

/* ── Suggestion popup ───────────────────────────────────────── */

SuggestionPopup {
    layer: popup;
    dock: bottom;
    offset-y: -3;              /* float above the 3-row ChatInput */
    width: 70;
    max-width: 90%;
    height: auto;
    max-height: 14;
    background: $surface;
    border: round $accent;
    padding: 0;
    display: none;
}

SuggestionPopup.-visible {
    display: block;
}

SuggestionPopup > .suggest-header {
    height: 1;
    background: $accent 15%;
    color: $accent;
    text-style: bold;
    padding: 0 1;
    dock: top;
}

SuggestionPopup > OptionList {
    height: auto;
    max-height: 12;
    background: $surface;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
}

SuggestionPopup > OptionList > .option-list--option {
    padding: 0 1;
}

SuggestionPopup > OptionList > .option-list--option-highlighted {
    background: $accent 30%;
    text-style: bold;
}

/* ── Status bar ─────────────────────────────────────────────── */

StatusBar {
    height: 1;
    background: $surface;
    color: $muted;
    padding: 0 1;
}
