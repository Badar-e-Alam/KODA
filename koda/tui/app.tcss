/* KODA TUI stylesheet
 *
 * Standard Textual theme variables ($primary, $accent, $background,
 * $surface, $foreground, $error) are provided by the active theme
 * registered in KodaApp.on_mount. We override them via /theme.
 *
 * Custom KODA vars below ($user, $tool, $tool-ok, $tool-err, $muted)
 * are defined here as CSS fallbacks. They stay constant across themes —
 * tuning them per-theme can come later; for now the semantic colors
 * (user=green, tool=amber, error=red) are consistent in every palette.
 */
$user: #9ece6a;
$tool: #e0af68;
$tool-ok: #73daca;
$tool-err: #f7768e;
$muted: #565f89;

Screen {
    background: $background;
    layers: base popup;
}

/* ── Layout ─────────────────────────────────────────────────── */

#app-root {
    layout: vertical;
    height: 100%;
    layer: base;
}

#main-row {
    height: 1fr;
    layout: horizontal;
}

#chat-area {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#messages {
    height: 1fr;
    min-height: 1;
    background: $background;
    padding: 0 1;
    scrollbar-size: 1 1;
}

#sidebar-host {
    width: 34;
    height: 100%;
    display: none;
}

#sidebar-host.visible {
    display: block;
}

#sidebar-host > SessionPanel {
    width: 100%;
}

/* ── Banner ─────────────────────────────────────────────────── */

/* Banner now lives INSIDE #chat-area (above #messages) so it shares
 * vertical space with the scroll region instead of stealing a fixed
 * slice at the top of the app. On short terminals (VS Code's
 * integrated shell, etc.) the max-height cap keeps the ASCII art from
 * pushing the ChatInput off-screen.
 */
KodaBanner {
    height: auto;
    max-height: 10;
    padding: 1 2;
    color: $primary;
    overflow: hidden;
}

/* Once the chat has started the banner hides entirely so the message
 * history owns the whole scroll region. Clipping the 12-row ASCII art
 * to a 1-row strip (the old behavior) left visible fragments of the
 * top edge of the block characters, which looked broken.
 */
KodaBanner.-compact {
    display: none;
}

/* ── Messages ───────────────────────────────────────────────── */

BaseMessage {
    height: auto;
    padding: 0 1;
    margin: 0 0 1 0;
}

UserMessage {
    color: $user;
    border-left: thick $user;
    padding-left: 1;
}

AssistantMessage {
    color: $foreground;
}

ToolCallMessage {
    color: $tool;
    padding: 0;
}

ToolCallMessage.-error {
    color: $tool-err;
}

AppMessage {
    color: $muted;
    text-style: italic;
}

ErrorMessage {
    color: $error;
    text-style: bold;
    border-left: thick $error;
    padding-left: 1;
}

ThinkingMessage {
    color: $muted;
    text-style: italic;
    height: 1;
    padding: 0 1;
}

/* ── Last-user-message preview ──────────────────────────────── */

.last-user-preview {
    height: 1;
    padding: 0 2;
    color: $muted;
    text-align: right;
    background: $background;
}

/* ── Chat input ─────────────────────────────────────────────── */

/* Docked to the bottom of #chat-area so it is ALWAYS visible,
 * regardless of how tall the banner + messages become. Without this,
 * the ~12-row ASCII banner could push the input off short terminals
 * (e.g. VS Code's embedded shell).
 */
ChatInput {
    dock: bottom;
    height: 3;
    border: round $muted;
    padding: 0 1;
    background: $surface;
}

ChatInput:focus {
    border: round $primary;
}

ChatInput.-shell {
    border: round $tool;
}

ChatInput.-command {
    border: round $accent;
}

/* ── Suggestion popup ─────────────────────────────────────────
 * Inline above the ChatInput — not a floating layer. Full width of
 * the chat area, height auto-sized to content, clamped by max-height.
 * Sits right at the top border of the input (Claude-Code / Codex style).
 */

SuggestionPopup {
    width: 100%;
    height: auto;
    max-height: 14;
    background: $surface;
    border: round $accent;
    padding: 0;
    margin: 0;
    display: none;
}

SuggestionPopup.-visible {
    display: block;
}

SuggestionPopup > .suggest-header {
    height: 1;
    background: $accent 15%;
    color: $accent;
    text-style: bold;
    padding: 0 1;
    dock: top;
}

SuggestionPopup > .suggest-footer {
    height: 1;
    color: $muted;
    padding: 0 1;
    dock: bottom;
}

SuggestionPopup > OptionList {
    height: auto;
    max-height: 10;
    background: $surface;
    border: none;
    padding: 0;
    scrollbar-size: 1 1;
}

SuggestionPopup > OptionList > .option-list--option {
    padding: 0 1;
}

SuggestionPopup > OptionList > .option-list--option-highlighted {
    background: $accent 30%;
    text-style: bold;
}

/* ── Status bar ─────────────────────────────────────────────── */

StatusBar {
    dock: bottom;
    height: 1;
    background: $surface;
    color: $muted;
    padding: 0 1;
}

/* ── Responsive breakpoints ─────────────────────────────────────
 * KodaApp.on_resize toggles `-short` and `-narrow` on #app-root based
 * on the live terminal size. The rules below collapse non-essential
 * chrome so VS Code's embedded shell (often ~20 rows × 80 cols) keeps
 * messages + input visible. The fixed sizes elsewhere in this sheet
 * are sized for a normal terminal; these overrides win by specificity.
 */

/* Short terminals (< 24 rows): kill the banner outright and shrink
 * the suggestion popup so the message scroll + input + status bar
 * always fit. Banner already hides via .-compact post-first-turn;
 * this just extends that to small-screen sessions before the first
 * user message.
 */
#app-root.-short KodaBanner {
    display: none;
}

#app-root.-short SuggestionPopup {
    max-height: 8;
}

#app-root.-short SuggestionPopup > OptionList {
    max-height: 5;
}

/* Narrow terminals (< 100 cols): hide the sidebar even if the user
 * toggled it open with Ctrl+B. Both selectors are needed because the
 * `.visible` rule above sets `display: block` and we must beat it.
 */
#app-root.-narrow #sidebar-host,
#app-root.-narrow #sidebar-host.visible {
    display: none;
}
