# ─── KODA agent config ───────────────────────────────────────────────────────
# How to invoke the agent: "import" (faster, in-process) or "subprocess"
EVAL_AGENT_MODE=import

# Model spec — KODA accepts "openai:X" / "ollama:X"
KODA_MODEL=ollama:qwen2.5-coder:7b

# For subprocess mode only — customize if your CLI takes different flags
EVAL_AGENT_CMD=koda --cwd {workdir} --model {model} --no-tui
EVAL_AGENT_TIMEOUT=300

# ─── Provider keys (used by KODA's inner OpenAI-compatible client) ───────────
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1

# Or for OpenAI:
# OPENAI_API_KEY=sk-...

# Or for Ollama Cloud:
# OLLAMA_API_KEY=...
# OLLAMA_BASE_URL=https://ollama.com/v1

# ─── Langfuse — get from https://cloud.langfuse.com ──────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
